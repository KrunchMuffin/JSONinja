{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSONinja",
  "version": "../package.json",
  "identifier": "com.dabworx.jsoninja",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JSONinja - Advanced JSON Viewer",
        "width": 1400,
        "height": 900,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5ODgyREE4NjlEMjI4OEMKUldTTUtOSnBxQzJJbVdnZmduNHZIL0NkRzNpWk5CRUZDMmxXVmRCeWprMmpCL2ZEb2JFRFB2ZSsK",
      "endpoints": ["https://github.com/KrunchMuffin/JSONinja/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Viewer for JSON, JSON Lines, JSONC and JSON5",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["json"],
        "name": "JSONinja.json",
        "description": "JavaScript Object Notation File",
        "mimeType": "application/json",
        "role": "Editor"
      },
      {
        "ext": ["jsonl", "ndjson"],
        "name": "JSONinja.jsonl",
        "description": "JSON Lines File",
        "mimeType": "application/jsonl",
        "role": "Editor"
      },
      {
        "ext": ["jsonc"],
        "name": "JSONinja.jsonc",
        "description": "JSON with Comments File",
        "role": "Editor"
      },
      {
        "ext": ["json5"],
        "name": "JSONinja.json5",
        "description": "JSON5 File",
        "mimeType": "application/json5",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}

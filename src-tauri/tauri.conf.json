{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSONinja",
  "version": "../package.json",
  "identifier": "com.dabworx.jsoninja",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JSONinja - Advanced JSON Viewer",
        "width": 1400,
        "height": 900,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Advanced JSON Viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["json"],
        "name": "JSON File",
        "description": "JavaScript Object Notation File",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
